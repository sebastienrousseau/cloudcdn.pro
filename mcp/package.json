{
  "name": "@sebastienrousseau/cloudcdn-mcp",
  "version": "0.1.1",
  "description": "MCP server for CloudCDN \u2014 lets AI agents autonomously manage digital assets, zones, image transforms, cache, and edge analytics.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./server.js",
    "./api-client": "./lib/api-client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cloudcdn-mcp": "./index.js"
  },
  "files": [
    "index.js",
    "server.js",
    "lib/",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudcdn",
    "cdn",
    "cloudflare",
    "ai-agents",
    "claude",
    "cursor",
    "windsurf",
    "vectorize"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "4.1.12"
  },
  "overrides": {
    "hono": ">=4.13.11 <5.0.0",
    "@hono/node-server": "^1.19.15",
    "ip-address": ">=10.7.4 <11.0.0",
    "vite": ">=8.1.6 <9.0.0",
    "fast-uri": ">=3.1.9 <4.0.0",
    "nanoid": "^5.1.7",
    "qs": "^6.16.0",
    "body-parser": ">=2.4.0 <3.0.0"
  },
  "homepage": "https://cloudcdn.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/cloudcdn.pro.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/cloudcdn.pro/issues"
  },
  "author": "Sebastien Rousseau",
  "license": "Apache-2.0 OR MIT"
}
